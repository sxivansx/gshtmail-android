<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The session is tied to this phone's keystore, so it is never backed up or moved. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ghstmail_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ghstmail_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
